@@ -416,6 +419,42 @@ static int bt_powerup(int en )
             return -1;
         }
     }
+
+    /* DORA_V9_OPTIONAL_EXTLDO: not all Sony 4.4 rfkill drivers expose extldo.
+     * This is an optional hardware capability query, not the power switch.
+     * Do not change the transport reference count until this preflight passes.
+     */
+    ret = asprintf(&enable_ldo_path, "/sys/class/rfkill/rfkill%d/device/extldo", rfkill_id);
+    if (ret < 0 || enable_ldo_path == NULL) {
+        ALOGE("Memory allocation failure for extldo path");
+        return -1;
+    }
+    fd_ldo = open(enable_ldo_path, O_RDONLY);
+    if (fd_ldo < 0) {
+        if (errno == ENOENT) {
+            ALOGW("%s: optional extldo absent; using rfkill directly", __func__);
+            enable_extldo = FALSE;
+        } else {
+            ALOGE("open(%s) failed: %s (%d)", enable_ldo_path, strerror(errno), errno);
+            free(enable_ldo_path);
+            return -1;
+        }
+    } else {
+        size = read(fd_ldo, &enable_ldo, sizeof(enable_ldo));
+        close(fd_ldo);
+        if (size <= 0) {
+            ALOGE("read(%s) failed: %s (%d)", enable_ldo_path, strerror(errno), errno);
+            free(enable_ldo_path);
+            return -1;
+        }
+        enable_extldo = (size >= 4 && !memcmp(enable_ldo, "true", 4)) ? TRUE : FALSE;
+        if (enable_extldo) {
+            ALOGI("External LDO has been configured");
+        }
+    }
+    free(enable_ldo_path);
+    enable_ldo_path = NULL;
+
